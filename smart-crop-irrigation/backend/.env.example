# ThingSpeak Configuration
THINGSPEAK_CHANNEL_ID=3523427
# Optional: Provide read API key if the channel is private. Do not commit actual secrets.
THINGSPEAK_READ_API_KEY=

# Application Timezone (aligns with crop environment and dataset Day/Time features)
APP_TIMEZONE=Asia/Kolkata

# Telemetry Freshness Threshold in seconds (ThingSpeak upload interval is ~20s)
TELEMETRY_FRESHNESS_THRESHOLD_SECONDS=120
